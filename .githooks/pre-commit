#!/usr/bin/env python3
"""Auto-bump the last version segment of any staged __manifest__.py.

Runs as a git pre-commit hook. For every __manifest__.py added or modified
in this commit, increments the last numeric segment of the manifest's
`version` key (e.g. 19.0.1.0.3 -> 19.0.1.0.4) and re-stages the file.

If a manifest's `version` value isn't the expected 5 dot-separated numeric
segments, the file is left untouched and a notice is printed - this hook
never blocks a commit.
"""
import re
import subprocess
import sys

VERSION_RE = re.compile(
    r"""(?P<qk>['"])version(?P=qk)(?P<sep>\s*:\s*)(?P<qv>['"])(?P<ver>\d+(?:\.\d+){4})(?P=qv)"""
)


def staged_manifests():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [line for line in result.stdout.splitlines() if line.endswith("__manifest__.py")]


def bumped_version(ver):
    parts = ver.split(".")
    parts[-1] = str(int(parts[-1]) + 1)
    return ".".join(parts)


def replacement(match, new_ver):
    return (
        match.group("qk") + "version" + match.group("qk") + match.group("sep")
        + match.group("qv") + new_ver + match.group("qv")
    )


def main():
    manifests = staged_manifests()
    if not manifests:
        return 0

    for path in manifests:
        try:
            with open(path, "r", encoding="utf-8") as f:
                content = f.read()
        except OSError as exc:
            print(f"pre-commit: could not read {path} ({exc}), skipping version bump")
            continue

        match = VERSION_RE.search(content)
        if not match:
            print(
                f"pre-commit: {path} has no 'version' key with 5 numeric "
                "segments, skipping version bump"
            )
            continue

        old_ver = match.group("ver")
        new_ver = bumped_version(old_ver)
        new_content = content[:match.start()] + replacement(match, new_ver) + content[match.end():]

        with open(path, "w", encoding="utf-8") as f:
            f.write(new_content)

        subprocess.run(["git", "add", path], check=True)

        print(f"pre-commit: bumped {path} version {old_ver} -> {new_ver}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
