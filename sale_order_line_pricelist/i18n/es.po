msgid "ID"
msgstr "ID"

#. module: sale_order_line_pricelist
#: model:ir.model.fields,field_description:sale_order_line_pricelist.field_sale_order_line__line_pricelist_manual
msgid "Line price list set manually"
msgstr "Lista de precios de la línea elegida manualmente"

#. module: sale_order_line_pricelist
#: model:ir.model.fields,field_description:sale_order_line_pricelist.field_sale_order_line__line_pricelist_id
msgid "Price list"
msgstr "Lista de precios"

#. module: sale_order_line_pricelist
#: model:ir.model.fields,help:sale_order_line_pricelist.field_sale_order_line__line_pricelist_id
msgid ""
"Price list used to compute this line's unit price. Follows the order's price"
" list unless it is changed on this line, for example to sell the same "
"product twice at different prices."
msgstr ""
"Lista de precios usada para calcular el precio unitario de esta línea. "
"Sigue a la lista de precios de la orden, salvo que se cambie en esta línea, "
"por ejemplo para vender el mismo producto dos veces a precios distintos."

#. module: sale_order_line_pricelist
#: model:ir.model,name:sale_order_line_pricelist.model_sale_order_line
msgid "Sales Order Line"
msgstr "Línea de la orden de venta"

#. module: sale_order_line_pricelist
#: model:ir.model.fields,help:sale_order_line_pricelist.field_sale_order_line__line_pricelist_manual
msgid ""
"Technical field: set when the line's price list was chosen on the line "
"itself. Such a line keeps its price list when the order's price list "
"changes; the other lines follow it."
msgstr ""
"Campo técnico: se marca cuando la lista de precios se eligió en la propia "
"línea. Esa línea conserva su lista de precios cuando cambia la lista de "
"precios de la orden; las demás líneas la siguen."
