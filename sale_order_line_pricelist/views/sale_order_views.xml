<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_order_line_pricelist" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.order.line.pricelist</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="line_pricelist_manual" column_invisible="1"/>
                <field name="line_pricelist_id"
                       groups="product.group_product_pricelist"
                       readonly="qty_invoiced &gt; 0"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
